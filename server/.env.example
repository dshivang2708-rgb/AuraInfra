# Copy this file to .env and fill in real values. Never commit the real .env file.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Resend (transactional email) — used by the "Enquire About This Project" forms.
RESEND_API_KEY=your-resend-api-key-here
# Until a domain is verified in Resend, leave this as the sandbox sender —
# see server/README.md for what changes once you verify a domain.
RESEND_FROM_EMAIL=AuraInfra <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=aurainfraadmin@gmail.com